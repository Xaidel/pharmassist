# Compose stack
POSTGRES_DB=pharmassist
POSTGRES_USER=pharmassist
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
APP_ENV=dev
CADDY_PORT=8080

# Host-side database tooling (Compose publishes Postgres on loopback)
DATABASE_URL=postgres://pharmassist:change-me@127.0.0.1:5432/pharmassist

# App runtime
HOST=0.0.0.0
PORT=3000
ROUTING_BASE_URL=https://router.project-osrm.org

# Prescription scan: mock (default) or cloud-vision, behind the same port.
SCAN_PROVIDER=mock
# Cloud Vision is selected only when both SCAN_PROVIDER=cloud-vision and this
# flag are true; anything else fails closed.
SCAN_CLOUD_VISION_ENABLED=false
# Path to the Google service-account key for Cloud Vision. Keep the key file
# outside the repository; it is read by the SDK, not committed.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
